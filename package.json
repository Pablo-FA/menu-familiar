{
  "name": "menu-familiar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "types": "wrangler types --include-env=false",
    "typecheck": "npm run types && tsc -b",
    "lint": "eslint .",
    "build": "npm run typecheck && vite build",
    "check": "npm run lint && npm run build",
    "preview": "npm run build && vite preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migration:new": "wrangler d1 migrations create DB",
    "deploy": "sh scripts/deploy.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.61.0",
    "@cloudflare/vitest-plugin": "^1.3.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^4.1.0",
    "wrangler": "^4.142.0"
  },
  "engines": {
    "node": ">=22.12"
  }
}
